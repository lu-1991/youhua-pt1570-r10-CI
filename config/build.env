# 云编译参数: 工作流通过 `set -a; . config/build.env` 读取
# 改这一处即可换上游版本/机型, 不用动 workflow 文件

# 上游 PonWRT-TYFZA1 源码(在线拉取, 不落盘到本仓库)
PONWRT_REPO=https://github.com/LeoooChen/PonWRT-TYFZA1
# 0.8.5-beta (2026-11-08) — tests: test_storage_boards / test_sysupgrade_board 通过
PONWRT_REF=f74af178efe542ecf9d40bad5833c949b5f29c5c

# 上游发布的运行时固件(无线/OMCI 二进制), 编译时在线取用
RUNTIME_RELEASE=v0.1.0-alpha
RUNTIME_ASSET=tyfza1-runtime-inputs-v1.tar.gz
# FIT 签名用开发密钥(公开测试密钥, 与上游 workflow 一致)
SIGNING_KEY_URL=https://raw.githubusercontent.com/jameywine/GPL-for-GP3000/5090fbcb6ba743dd7b1314811ef557bad0460147/bootloader/Verified_Boot/verifed_key_06-04-2020/dev.key
SIGNING_KEY_SHA256=bea80932793531fe263f62bf4de3ee95754ea7b9766eda23a418c22f06ce127f

# 默认机型: PT1570-R10 是四口千兆(RTL9617C), 用 rtl9617c-tyfza1-ubi.dtb
DEFAULT_VARIANT=four_gbe
