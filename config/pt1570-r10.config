# PT1570-R10 的 .config 覆盖片段
# 由 CI 追加到上游 port/configs/tyfza1-boot.config 之后, 再 make defconfig。
# 只写"与本机启动方式相关"的差异, 其余保持上游默认, 避免分叉。
#
# 两套目标共用这一份 .config:
#   fit  : U-Boot 2026.07, 内核 fitblk 把 FIT 里的 rootfs 子镜像映射成 /dev/fit0
#   oem  : 原厂 U-Boot 2020.01, 内核 ubiblock 把 ubi_r0 映射成 /dev/ubiblock0_3
# 两者都开着不会互相干扰(挂根设备由 bootargs 决定), 所以不必按目标裁剪。

# --- 目标与机型(硬件与原厂布局和 TYFZA1 同源, 复用同一 target) ---
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_rtl9617c_generic_DEVICE_tianyi_tyfza1=y

# --- 根文件系统: SquashFS 只读根 + UBI 卷做 overlay ---
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- fit 目标: uImage.FIT 子镜像块驱动 + 释放块设备的用户态工具 ---
# CONFIG_UIMAGE_FIT_BLK 来自 OpenWrt 通用补丁
#   target/linux/generic/pending-6.18/510-block-add-uImage.FIT-subimage-block-driver.patch
# 打开后: 只要 /chosen 里有 u-boot,version 和 rootdisk, 且 FIT 里带
# type="filesystem" 的 loadable 子镜像, 内核就注册 /dev/fit0。
# 没有它, 2026.07 引导的 FIT 固件会停在 "VFS: Cannot open root device"。
CONFIG_UIMAGE_FIT_BLK=y
# fitblk 包: /usr/sbin/fitblk(ioctl 释放 /dev/fit0) + /lib/upgrade/fit.sh(fit_do_upgrade)
CONFIG_PACKAGE_fitblk=y

# --- 管理界面与 PON ---
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-tyfza1-pon=y
CONFIG_PACKAGE_tyfza1-pon-control=y
CONFIG_PACKAGE_tyfza1-storage=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y

# --- 版本标识, 出问题时能一眼看出是云编译产物 ---
CONFIG_VERSION_DIST="PT1570-R10-CI"
